<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ad-hoc / swiftc builds only — omits system-extension.install,
	     which requires a real provisioning profile and SIGKILLs the
	     process at launch when applied to an ad-hoc signature. -->
	<key>com.apple.security.device.usb</key>
	<true/>
</dict>
</plist>
