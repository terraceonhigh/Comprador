# Build artifacts
build/
dist/
# Throwaway .app bundles from notarization step-comparison debugging (May 2026).
dist-compare/

# macOS
.DS_Store

# Xcode
DerivedData/
*.xcuserdata

# Go
*.test

# IDE
.idea
.vscode

# Editor backup / autosave files
*~
*-autosave.*

# Generated icon (built from images/icon.png by `make icon`)
MenuBarApp/Resources/Comprador.icns

# Logs
*.log

# Environment / secrets
.env*

# Letters and test fixtures: stay on disk for the next agent to read,
# never in git. Ignoring also keeps `git stash --include-untracked`
# from sweeping them off disk during branch switches.
correspondence/
Correspondance/
testfiles/

# Local worktrees / scheduled-task state (per-machine, not in git)
.claude/
# Registered git worktrees live here (e.g. test/morning-scripts); the checkouts
# are per-machine and must never be tracked by the parent repo.
worktrees/

# Cross-agent coordination scratch files
forGPT.md

# Garden marginalia — the agent's notes are local-only by default. Only the
# README and the example travel; every real entry stays on this machine (the
# gitignore is the lock, the visible: flag is the covenant — see
# garden/marginalia/README.md). Earned in Galatea, 2026-06-07.
garden/marginalia/*
!garden/marginalia/README.md
!garden/marginalia/00-example.md
